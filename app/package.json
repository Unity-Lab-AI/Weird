{
  "name": "dungeon-master-the-hunt-app",
  "version": "1.0.0",
  "description": "Desktop installer and launcher for DUNGEON MASTER: THE HUNT",
  "main": "main.js",
  "author": "Unity AI Lab",
  "license": "ISC",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.unityailab.dungeonmasterthehunt",
    "productName": "Dungeon Master The Hunt",
    "executableName": "DungeonMasterTheHunt",
    "directories": { "output": "../dist" },
    "files": [
      "main.js", "preload.js", "paths.js", "supervisor.js", "setup.js",
      "setup.html", "installer-stop.ps1", "icon.png"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "game",
        "filter": [
          "index.html", "game.html", "wiki.html", "doc.html", "favicon.svg", "og-card.png",
          "css/**/*", "js/**/*", "assets/**/*"
        ]
      },
      {
        "from": "../local-services",
        "to": "local-services",
        "filter": ["**/*", "!**/__pycache__/**"]
      }
    ],
    "win": { "target": ["nsis"], "icon": "icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "artifactName": "DungeonMasterTheHunt-Setup-${version}.exe",
      "shortcutName": "Dungeon Master The Hunt",
      "uninstallDisplayName": "Dungeon Master The Hunt"
    }
  }
}
